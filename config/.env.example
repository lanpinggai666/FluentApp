# 复制成 config/.env 后按机器实际情况修改；这个文件的值会覆盖代码默认值，
# 但真实环境变量优先级更高（容器里用 -e 注入即可，不必改文件）。
#
# 权限：chmod 640 config/.env，属主给 web 进程用户。目录已有 .htaccess 兜底，
# 但生产仍必须把 web 根指向 public/，否则 .env 在 Apache 之外（如 Nginx 直连静态文件）会被下载。

# 生产就填 production。调试回显只在该值或显式 APP_DEBUG=1 时开启。
APP_ENV=production
APP_DEBUG=0

# sqlite（零配置，单机够用）| mysql（多进程/大数据量）| auto（先试 MySQL，连不上退回 SQLite）
DB_CONNECTION=sqlite

# 用 SQLite 时建议把库放到 web 根之外，避免误配文档根时被下载
# DB_SQLITE_PATH=/var/www/softnav-data/softnav.sqlite

# 用 MySQL 时填这几项；不要用 root，也不要留空密码
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=software_nav
# DB_USERNAME=softnav
# DB_PASSWORD=换成你的密码
